# =============================================================================
#  Variables d'environnement — BMA
# =============================================================================
#  Copier ce fichier en .env.local et renseigner les valeurs.
#  .env.local n'est JAMAIS versionné : c'est là que vivent les secrets.
#  Les mêmes variables doivent être déclarées sur Vercel :
#  Project → Settings → Environment Variables.
# =============================================================================


# --- Base de données et photos ------------------------------------------------
#  Supabase → Project Settings → API
#  · SUPABASE_URL       : « Project URL »
#  · SERVICE_ROLE_KEY   : « service_role », la clé secrète — surtout PAS l'anon
#
#  ⚠️ La clé service_role contourne toutes les règles de sécurité de la base.
#     Elle ne doit apparaître ni dans le navigateur, ni dans une capture d'écran,
#     ni dans un message. Si elle fuite : Supabase → API → rotate.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SERVICE_ROLE_KEY=

# --- Adresse officielle du site ------------------------------------------------
#  Racine de tout le référencement : adresse canonique de chaque page, plan du
#  site, données structurées, images de partage WhatsApp.
#  Sans www ni barre oblique finale de trop — une seule forme, toujours la même.
#  Si la variable est absente, le code retombe sur www.bayemorautomobile.com.
NEXT_PUBLIC_SITE_URL=https://www.bayemorautomobile.com

# --- Signature des sessions ---------------------------------------------------
#  Sert à signer le cookie de session du back-office. Changer cette valeur
#  déconnecte tout le monde immédiatement — c'est le bouton d'arrêt d'urgence.
#  En générer une : openssl rand -hex 32
AUTH_SECRET=

# =============================================================================
#  Note : ADMIN_PASSWORD n'existe plus.
#  Le back-office fonctionnait avec un mot de passe unique partagé. Depuis
#  l'arrivée d'une assistante au showroom, chaque personne a son propre compte,
#  créé depuis Back-office → Comptes. Cette variable peut être supprimée
#  du .env.local comme des variables Vercel.
# =============================================================================
